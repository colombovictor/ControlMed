{
"compilerOptions": {
"moduleDetection": "force",
"module": "ESNext",
"target": "es2016",
"lib": ["dom", "es2016"],
"rootDir": "./src",
"outDir": "./dist",
"strict": true,
"esModuleInterop": true,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true,
},
"include": ["src/**/*"],
"exclude": ["node_modules", "dist"]
}